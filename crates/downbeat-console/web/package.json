{
  "name": "downbeat-console-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && bun build ./index.html --outdir dist --production --public-path /",
    "check": "bun check --no-script",
    "lint": "oxlint --deny-warnings src dev.ts",
    "fmt": "bun fmt --no-script",
    "test": "bun test",
    "dev": "bun run dev.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2"
  }
}
