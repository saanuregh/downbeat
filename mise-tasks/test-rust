#!/usr/bin/env bash
#MISE description="Run the Rust tests against a throwaway Postgres; arguments go to cargo test"
# Plain bash, so CI runs it without mise. Arguments go to `cargo test`, for example
# `mise run test-rust -p downbeat-e2e --test runs`.
set -euo pipefail
# shellcheck source=mise-tasks/postgres.sh
source "$(dirname "$0")/postgres.sh"

export DOWNBEAT_TEST_DATABASE_URL="$DOWNBEAT_PG_URL"
# The sign-in test against a real identity provider runs when Dex is available.
if [ -z "${DOWNBEAT_TEST_DEX:-}" ] && command -v dex >/dev/null; then
  DOWNBEAT_TEST_DEX="$(command -v dex)"
  export DOWNBEAT_TEST_DEX
fi
# The end-to-end tests start the console binary, which no test target builds by itself.
cargo build --workspace --bins
cargo test --workspace "$@"
